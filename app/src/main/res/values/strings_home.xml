    <string name="settings_no_calls_summary">This device\'s Phone calls through your phone, by way of the computer, and shows the phone\'s calls as they ring. The voice stays on the phone.</string>
    <string name="settings_is_dialer">Tetra is the phone app</string>
    <string name="settings_not_dialer">Tetra is not the phone app</string>
    <string name="settings_is_dialer_summary">Calls ring and are spoken on Tetra\'s own call screen. To give it back: Android\'s Default apps › Phone app.</string>
    <string name="settings_not_dialer_summary">As the phone app, Tetra shows its own call screen and buzzes when they answer. The phone\'s own call recording is not shown then.</string>
    <string name="settings_change">Change</string>
    <string name="settings_make_it">Make it</string>
    <string name="settings_open_phone_summary">Speed dial and spam are in its own settings</string>
    <string name="settings_calls">Calls</string>
    <string name="settings_buzz_answer_summary">Two short taps when the other side picks up a call you made</string>
    <string name="settings_buzz_end_summary">One tap when a call that was answered ends</string>
    <string name="settings_silence_unknown_summary">They ring without sound and show in Recents as missed</string>
    <string name="settings_decline_hidden_summary">Calls that hide their number are declined before they ring</string>
    <string name="settings_with_computer">With the computer</string>
    <string name="settings_with_computer_on">Once for Tetra, not for each contact. To take it back: Android\'s Settings › Apps › Tetra › Permissions › Phone and Call logs.</string>
    <string name="settings_with_computer_off">Allow asks once, for Tetra (not for each contact): to place a call, to see a call ringing, and to answer or end it from the computer. The caller\'s number and the rest come with Tetra as the phone app.</string>
    <string name="settings_with_computer_sound">The sound stays on the phone, unless the phone is connected to the computer by Bluetooth for calls (the computer\'s Settings › Calls).</string>
    <string name="settings_pc_calls_on">The computer shows this phone\'s calls (answer, decline, end) and can place calls through it</string>
    <string name="settings_pc_calls_off">Off: the computer hears of no call here and cannot place one</string>
    <string name="settings_phone_permission_on">Allowed: Call on the computer rings here at once, and the computer sees this phone\'s calls</string>
    <string name="settings_phone_permission_off">Each call from the computer comes as a notification to tap, and the computer does not see this phone\'s calls</string>
